QWEN36_BASE_URL=
QWEN36_API_KEY=EMPTY

QWEN38_BASE_URL=
QWEN38_API_KEY=EMPTY

QWEN35_9B_BASE_URL=
QWEN35_9B_API_KEY=EMPTY

QWEN35_4B_BASE_URL=
QWEN35_4B_API_KEY=EMPTY

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL_TEMP=
DEEPSEEK_BASE_URL_TEMP_KEY=

# 旧 checkpoint 来源，仅供显式历史迁移和回滚读取；普通运行不再写入。
LLM_GRAPH_CHECKPOINT_BACKEND=sqlite
LLM_GRAPH_CHECKPOINT_SQLITE_PATH=outputs/checkpoints/tool_agent.sqlite
# LLM_GRAPH_CHECKPOINT_POSTGRES_URL=postgresql://user:password@127.0.0.1:5433/database?sslmode=disable

# 对话日志业务数据库。支持 postgresql:// 和 sqlite:/// URL。
# 留空时跟随 checkpoint 后端；SQLite 使用独立的 outputs/conversations 文件。
# LLM_GRAPH_DATABASE_URL=sqlite:///outputs/conversations/conversation.sqlite3
# LLM_GRAPH_DATABASE_URL=postgresql://user:password@127.0.0.1:5433/database?sslmode=disable
LLM_GRAPH_DATABASE_URL=

# PostgreSQL RAG
RAG_POSTGRES_URL=postgresql://user:password@127.0.0.1:5434/database?sslmode=disable

# Local OpenAI-compatible embedding service
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
RAG_EMBEDDING_API_KEY=local-embedding-key
RAG_EMBEDDING_MODEL=qwen3-embedding-4b
RAG_EMBEDDING_DIMENSIONS=1024

# Optional local Phoenix tracing
PHOENIX_TRACING_ENABLED=false
# HTTP collector base URL; tracing uses HTTP/protobuf at /v1/traces.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=llm-graph
